export AREA_DATA_ROOT=/path/to/data-root
export MODEL=Qwen/Qwen2.5-VL-7B-Instruct
export CUDA_VISIBLE_DEVICES=0
export OUTPUT_ROOT=./outputs

# Optional image-index retriever for E-VQA and InfoSeek.
export AREA_RETRIEVER_DIR=/path/to/retriever-module

# Required only by the AMBER-D evaluator.
export AMBER_ANNOTATION=/path/to/annotations.json
